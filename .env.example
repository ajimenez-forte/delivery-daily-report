# Copia este archivo como .env.local y llena los valores. .env.local no se sube al repo.
# Nunca pegues estos valores en un chat, un issue o un commit.

# --- App (Next.js, etapa 2). Estas dos también van en Vercel. Son públicas por diseño:
# --- RLS protege los datos aunque alguien las vea.
# Supabase > Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase > Project Settings > API Keys > Publishable key (o "anon public" en proyectos viejos)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Script de importación (Python). SOLO en .env.local de tu computador. NO va en Vercel.
# Supabase > botón Connect > Session pooler > URI, con la contraseña de la base en lugar de [YOUR-PASSWORD].
DATABASE_URL=
